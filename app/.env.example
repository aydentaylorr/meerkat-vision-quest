# Copy to .env to set these. Both are optional in development.

# The game server. Left unset, the app looks for it on the machine running the Expo dev server,
# port 8000 (start it with `make run-lan` from the repository root). Set it for release builds.
# EXPO_PUBLIC_API_URL=https://your-deployed-game.example.com

# Only if the server is a preview behind MVQ_SITE_PASSWORD. This ends up inside the app bundle,
# so it is no more secret than the preview password already is.
# EXPO_PUBLIC_SITE_PASSWORD=
